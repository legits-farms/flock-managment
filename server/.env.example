# The PostgreSQL database. A hosted one usually needs ?sslmode=require at the end.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/flock_management
PORT=5000
# Long random value used to sign login tokens. Keep it secret.
JWT_SECRET=change-me-to-a-long-random-value

# Only for `npm run copy:mongo`, the one-time move from the old MongoDB database
# MONGO_URI=mongodb://127.0.0.1:27017/flock-management
# Set this if a mongodb+srv:// address fails with "querySrv ECONNREFUSED"
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Sign-up approval: new accounts are emailed to the manager through Resend (https://resend.com)
# RESEND_API_KEY=
# Who approves new accounts. Sign-up stays off until both are set.
# MANAGER_EMAIL=
# Address the app is opened at; the approval link in the email points here.
# Defaults to the Vercel production address, or http://localhost:5173
# APP_URL=
# Sender, once a domain is verified in Resend. Defaults to onboarding@resend.dev
# MAIL_FROM=
